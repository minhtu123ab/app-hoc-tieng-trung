generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum HskLevel {
  HSK1
  HSK2
  HSK3
  HSK4
  HSK5
  HSK6
  ADVANCED
}

enum DeckSource {
  AI
  MANUAL
}

enum WordStatus {
  NEW
  LEARNING
  FORGETTING
  MASTERED
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum PracticeMode {
  VIET_TO_HAN
  HAN_TO_VIET
  LISTEN_TYPE
  FILL_BLANK
  SENTENCE_ORDER
  WORD_BANK
  MATCH_PAIRS
  AI_CONVERSATION
}

enum TutorRole {
  USER
  ASSISTANT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  hskLevel       HskLevel @default(HSK1)
  dailyGoal      Int      @default(20)
  streakCount    Int      @default(0)
  lastStudyDate  DateTime?
  createdAt      DateTime @default(now())

  decks            Deck[]
  sentenceDecks    SentenceDeck[]
  wordProgress     UserWordProgress[]
  sentenceProgress UserSentenceProgress[]
  practiceSessions PracticeSession[]
  tutorMessages    TutorMessage[]
}

model Deck {
  id        String     @id @default(cuid())
  userId    String
  title     String
  topic     String
  hskLevel  HskLevel
  source    DeckSource @default(MANUAL)
  createdAt DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  words Word[]

  @@index([userId])
}

model Word {
  id            String   @id @default(cuid())
  deckId        String
  hanzi         String
  pinyin        String
  meaningVi     String
  partOfSpeech  String?
  exampleHanzi  String?
  examplePinyin String?
  exampleVi     String?
  hskLevel      HskLevel

  deck     Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress UserWordProgress[]

  @@index([deckId])
}

model SentenceDeck {
  id        String     @id @default(cuid())
  userId    String
  title     String
  topic     String
  hskLevel  HskLevel
  source    DeckSource @default(MANUAL)
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentences Sentence[]

  @@index([userId])
}

model Sentence {
  id              String   @id @default(cuid())
  sentenceDeckId  String
  hanzi           String
  pinyin          String
  meaningVi       String
  tokens          String[]
  hskLevel        HskLevel

  sentenceDeck SentenceDeck           @relation(fields: [sentenceDeckId], references: [id], onDelete: Cascade)
  progress     UserSentenceProgress[]

  @@index([sentenceDeckId])
}

model UserSentenceProgress {
  id             String     @id @default(cuid())
  userId         String
  sentenceId     String
  status         WordStatus @default(NEW)
  easeFactor     Float      @default(2.5)
  intervalDays   Int        @default(0)
  repetitions    Int        @default(0)
  dueDate        DateTime   @default(now())
  lastReviewedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentence   Sentence    @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@unique([userId, sentenceId])
  @@index([userId, dueDate])
}

model UserWordProgress {
  id              String     @id @default(cuid())
  userId          String
  wordId          String
  status          WordStatus @default(NEW)
  easeFactor      Float      @default(2.5)
  intervalDays    Int        @default(0)
  repetitions     Int        @default(0)
  dueDate         DateTime   @default(now())
  lastReviewedAt  DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@unique([userId, wordId])
  @@index([userId, dueDate])
}

model ReviewLog {
  id                     String        @id @default(cuid())
  userWordProgressId     String?
  userSentenceProgressId String?
  rating                 ReviewRating?
  mode                   PracticeMode?
  isCorrect              Boolean?
  reviewedAt             DateTime      @default(now())

  userWordProgress     UserWordProgress?     @relation(fields: [userWordProgressId], references: [id], onDelete: Cascade)
  userSentenceProgress UserSentenceProgress? @relation(fields: [userSentenceProgressId], references: [id], onDelete: Cascade)

  @@index([userWordProgressId])
  @@index([userSentenceProgressId])
}

model PracticeSession {
  id        String       @id @default(cuid())
  userId    String
  mode      PracticeMode
  total     Int          @default(0)
  correct   Int          @default(0)
  startedAt DateTime     @default(now())
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TutorMessage {
  id        String    @id @default(cuid())
  userId    String
  threadId  String    @default("main")
  role      TutorRole
  content   String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, threadId])
}

model WordFavorite {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  isHard    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, wordId])
  @@index([userId])
}
